{
  "manifest_version": 3,
  "name": "Flow Translate",
  "version": "1.0.0",
  "description": "Ferramenta de estudo de idiomas com tradutor integrado e sistema de flashcards diretamente na navegação.",

  "permissions": ["storage", "activeTab", "scripting"],

  "host_permissions": ["https://translate.googleapis.com/*"],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Flow Translate"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
